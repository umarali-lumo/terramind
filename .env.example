# TerraMind environment configuration
# Copy this file to `.env` and adjust values. Never commit real secrets.

# --- Database ---------------------------------------------------------
# SQLite (zero-setup development):
DATABASE_URL=sqlite:///./backend/terramind.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://terramind:password@localhost:5432/terramind

# --- Authentication ----------------------------------------------------
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_DAYS=7

# --- Frontend ----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Disease detection AI ----------------------------------------------
# Open Hugging Face image-classification model (PlantVillage-style labels)
DISEASE_MODEL_NAME=mesabo/agri-plant-disease-resnet50
DISEASE_MODEL_ENABLED=true

# --- Weather intelligence ----------------------------------------------
# auto = try Open-Meteo, fall back to deterministic simulation offline
WEATHER_PROVIDER=auto
WEATHER_CACHE_SECONDS=900

# --- AI Copilot ---------------------------------------------------------
# rules = built-in farm-data engine (no external dependency)
# openai = any OpenAI-compatible chat-completions API
COPILOT_PROVIDER=rules
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
